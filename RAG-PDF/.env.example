# copy to .env and fill in. never commit .env

# --- chat model (writes the answer) ---
LLM_PROVIDER=groq            # groq | openai
GROQ_API_KEY=your_groq_api_key_here
# LLM_MODEL=openai/gpt-oss-20b   # default per provider; check names at https://api.groq.com/openai/v1/models
# OPENAI_API_KEY=            # only if LLM_PROVIDER=openai or EMBED_BACKEND=openai

# --- embeddings (text -> numbers for search) ---
EMBED_BACKEND=fastembed      # fastembed (local, free) | openai
# EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2   # id + en, 384 dim
# EMBED_MODEL=BAAI/bge-small-en-v1.5                                        # english only, smaller/faster
# changing EMBED_MODEL starts a new empty collection: upload your pdfs again
